# QAT LINK API runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/shared_ledger
DATABASE_POOL_MAX=10

# Every secret must be at least 32 bytes. Never commit real values.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
OTP_PEPPER=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes

# Production OTP delivery: HTTPS webhook receives { phoneE164, code, expiresAt }.
# Leave empty only for local development; production startup refuses to start.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

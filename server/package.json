{
  "name": "@shared-ledger/approval-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --import tsx --test src/*.test.ts",
    "test:e2e": "node --import tsx --test e2e/*.test.ts",
    "test:two-device-e2e": "node --import tsx e2e/run-two-device-e2e.ts",
    "start": "node dist/src/server.js",
    "dev": "node --import tsx --watch src/server.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fastify": "5.2.1",
    "pg": "8.13.3"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "@types/pg": "8.11.11",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
}
